node_modules/
.git/
.expo/
*.log
*.apk
*.aab

# Local Gradle output. Regenerated by every build and ~185 MB here, so
# uploading it only slows the archive down — EAS builds android/ from source.
android/build/
android/app/build/
android/app/.cxx/
android/.gradle/

# Native folders are local-only (gitignored); EAS must regenerate them from
# app.config.js so plugins (Firebase, cleartext, build properties) apply.
/android/
/ios/

# Firebase config comes from the GOOGLE_SERVICES_JSON EAS file secret.
/google-services.json
/docs/
