<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- Only for API 24-28, where the public Download directory is still a real
       path. From API 29 the MediaStore insert needs no permission at all, so
       maxSdkVersion stops this being requested on any modern phone. -->
  <uses-permission
      android:name="android.permission.WRITE_EXTERNAL_STORAGE"
      android:maxSdkVersion="28" />
</manifest>
